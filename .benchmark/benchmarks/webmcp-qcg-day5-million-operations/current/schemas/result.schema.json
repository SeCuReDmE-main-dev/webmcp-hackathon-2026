{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"qcg-benchmark-result.v1",
  "type":"object",
  "required":["schema_version","benchmark_slug","run_id","gate","sandbox_id","seed","corpus_digest","operations","status","elapsed_ms","latency_ms","throughput_ops_per_second","decision_counts","checks"],
  "properties":{
    "schema_version":{"const":"qcg-benchmark-result.v1"},
    "benchmark_slug":{"const":"webmcp-qcg-day5-million-operations"},
    "run_id":{"type":"string","minLength":1},
    "gate":{"type":"string"},
    "sandbox_id":{"type":"string"},
    "seed":{"type":"integer"},
    "corpus_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "operations":{"type":"integer","minimum":0},
    "elapsed_ms":{"type":"number","minimum":0},
    "status":{"enum":["pass","fail","blocked","skipped"]},
    "error_count":{"type":"integer","minimum":0},
    "unauthorized_effects":{"type":"integer","minimum":0},
    "latency_ms":{"type":"object","required":["p50","p95","p99"],"properties":{"p50":{"type":"number","minimum":0},"p95":{"type":"number","minimum":0},"p99":{"type":"number","minimum":0}}},
    "throughput_ops_per_second":{"type":"number","minimum":0},
    "decision_counts":{"type":"object"},
    "checks":{"type":"object","required":["expected_decision_mismatches","unauthorized_effect_mismatches","receipt_missing","receipt_digest_mismatches","operation_digest"]}
  }
}
