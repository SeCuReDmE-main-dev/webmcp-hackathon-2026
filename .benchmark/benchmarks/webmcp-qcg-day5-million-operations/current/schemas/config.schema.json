{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"qcg-benchmark-config.v1",
  "type":"object",
  "required":["schema_version","benchmark_slug","engine","gates","resource_profiles","execution_policy"],
  "properties":{
    "schema_version":{"const":"qcg-benchmark-config.v1"},
    "benchmark_slug":{"type":"string","pattern":"^[a-z0-9-]+$"},
    "engine":{"type":"object","required":["seed","operations_per_sandbox","sandbox_count","total_operations"],"properties":{"seed":{"type":"integer"},"operations_per_sandbox":{"type":"integer","minimum":1},"sandbox_count":{"type":"integer","minimum":1},"total_operations":{"type":"integer","minimum":1}}},
    "gates":{"type":"array","minItems":1},
    "resource_profiles":{"type":"array","minItems":1},
    "execution_policy":{"type":"object","required":["launch_e2b","launch_http_canary","allow_provider_calls","allow_qpu_calls","allow_payment_calls"]}
  }
}
