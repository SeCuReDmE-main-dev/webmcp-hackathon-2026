{
  "manifest_version": 3,
  "name": "QCG Console Companion",
  "version": "0.2.1",
  "description": "A local bounded DevTools and side-panel companion for WebMCP-QCG.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Open QCG Companion" },
  "background": { "service_worker": "background.js", "type": "module" },
  "devtools_page": "devtools.html",
  "side_panel": { "default_path": "panel.html" },
  "permissions": ["clipboardWrite", "sidePanel"],
  "host_permissions": ["https://qcg.securedme.ca/*"],
  "content_scripts": [
    {
      "matches": ["https://qcg.securedme.ca/*"],
      "js": ["pageBridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://qcg.securedme.ca/*"],
      "js": ["contentBridge.js"],
      "run_at": "document_idle"
    }
  ]
}
